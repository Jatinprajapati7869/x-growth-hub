{
  "_comment": "Hermes-first: run X in terminal. MCP below is messaging bridge + optional emergency only.",
  "mcpServers": {
    "hermes-messaging": {
      "_note": "After: hermes plugins install mcp-serve",
      "command": "hermes",
      "args": ["mcp-serve"]
    }
  },
  "_emergency_do_not_enable_with_hermes_writes": {
    "x-actions": {
      "command": "npm",
      "args": ["run", "mcp"],
      "cwd": "REPO_ROOT/upstream/browser/XActions"
    },
    "x-use": {
      "command": "python",
      "args": ["-m", "x_use_mcp"],
      "env": {
        "X_USE_HOME": "USER_HOME/.x-growth-hub/x-use-home"
      }
    },
    "xsh": {
      "command": "xsh",
      "args": ["mcp"]
    }
  }
}
